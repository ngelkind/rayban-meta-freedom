captures/
firmware/
apk/
hardware/

# Never commit secrets or keys
*.pem
*.key
*.p12
*.keystore
secrets*
*token*
*.env
.env

# Python / env
.venv/
__pycache__/
*.pyc
.idea/

# OS
.DS_Store
